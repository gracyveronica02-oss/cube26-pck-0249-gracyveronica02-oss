# Environment configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database (PostgreSQL 16)
DATABASE_URL=postgres://pack_user:pack_password@localhost:5432/pack_manager_db

# Redis & BullMQ
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO local or AWS S3 / Cloudflare R2)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=pack-manager-evidence
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadminpassword

# AI Vision Providers (Optional - Mock provider is active by default)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Webhook Secrets
WEBHOOK_SECRET=pack-manager-secure-hmac-secret-2026
WEBHOOK_TARGET_URL=http://localhost:5000/webhook/fulfillment
